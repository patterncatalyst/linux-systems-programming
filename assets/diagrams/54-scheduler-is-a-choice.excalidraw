   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Go's runtime makes this decision for you and mostly will not be argued with (ch44). Boost.Fiber makes you choose, which is more work and more control.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Go's runtime makes this decision for you and mostly will not be argued with (ch44). Boost.Fiber makes you choose, which is more work and more control.",
   "lineHeight": 1.25,
   "baseline": 11
  },
