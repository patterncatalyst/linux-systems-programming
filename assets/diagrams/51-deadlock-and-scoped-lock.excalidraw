  {
   "id": "t1648573862",
   "type": "text",
   "x": 40,
   "y": 534,
   "width": 1089.0,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 967905532,
   "versionNonce": 433344177,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Both rows are real runs on this host. The deadlock is reproduced under timeout(1) and hard-gated, including the wchan reading \u2014 the abstraction's failure mode, named by the kernel.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Both rows are real runs on this host. The deadlock is reproduced under timeout(1) and hard-gated, including the wchan reading \u2014 the abstraction's failure mode, named by the kernel.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1660911551",
   "type": "text",
   "x": 40,
   "y": 558,
   "width": 738.1,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 156866018,
   "versionNonce": 1252168336,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Three threads park, not two: the two workers plus main, blocked in join(). All of them end up in the same kernel function.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Three threads park, not two: the two workers plus main, blocked in join(). All of them end up in the same kernel function.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t545156334",
   "type": "text",
   "x": 40,
   "y": 582,
   "width": 780.45,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1423604633,
   "versionNonce": 1191106248,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "scoped_lock is not lock_guard with more arguments. It runs a deadlock-avoidance algorithm, which is why opposing orders are safe.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "scoped_lock is not lock_guard with more arguments. It runs a deadlock-avoidance algorithm, which is why opposing orders are safe.",
   "lineHeight": 1.25,
   "baseline": 11
  }
 ],
