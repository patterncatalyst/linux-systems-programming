   "updated": 1,
   "link": null,
   "locked": false,
   "text": "verify.lua does NOT gate on whether elision happens \u2014 that would encode one compiler's choice as a rule. It gates that the count is measured, and compares the two.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "verify.lua does NOT gate on whether elision happens \u2014 that would encode one compiler's choice as a rule. It gates that the count is measured, and compares the two.",
   "lineHeight": 1.25,
   "baseline": 11
  },
