   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Counted by overloading operator new on the promise type, so every frame allocation is observed rather than inferred from a profiler.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Counted by overloading operator new on the promise type, so every frame allocation is observed rather than inferred from a profiler.",
   "lineHeight": 1.25,
   "baseline": 11
  },
