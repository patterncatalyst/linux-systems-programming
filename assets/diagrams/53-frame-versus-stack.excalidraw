   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Both hold one paused computation. Only one of them reserves 8 MiB of address space and a kernel task to do it \u2014 which is the whole reason coroutines exist.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Both hold one paused computation. Only one of them reserves 8 MiB of address space and a kernel task to do it \u2014 which is the whole reason coroutines exist.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t437932675",
   "type": "text",
   "x": 40,
   "y": 562,
   "width": 859.1,
   "height": 13.75,
