   "versionNonce": 1512863213,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Frame sizes are measured by overloading operator new inside promise_type: the only portable way to see a size the language deliberately hides.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Frame sizes are measured by overloading operator new inside promise_type: the only portable way to see a size the language deliberately hides.",
   "lineHeight": 1.25,
   "baseline": 11
  },
