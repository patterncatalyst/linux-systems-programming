   "link": null,
   "locked": false,
   "text": "sysmacros never runs at app runtime: it is pure tokens-in / tokens-out, executed only while rustc is compiling app.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "sysmacros never runs at app runtime: it is pure tokens-in / tokens-out, executed only while rustc is compiling app.",
   "lineHeight": 1.25,
   "baseline": 12
  },
