   "roundness": null,
   "seed": 1836771290,
   "versionNonce": 522122347,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "NEITHER band is measured here. Both are assembled from earlier measurements, carried into the table arm as named constants beside the instrument that produced them.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "NEITHER band is measured here. Both are assembled from earlier measurements, carried into the table arm as named constants beside the instrument that produced them.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t858196072",
   "type": "text",
   "x": 24,
   "y": 586,
   "width": 931.7,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1150282616,
   "versionNonce": 1494805449,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Cost and capability move together and in opposite directions: the more a paused computation costs, the fewer restrictions there are on where it may pause.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Cost and capability move together and in opposite directions: the more a paused computation costs, the fewer restrictions there are on where it may pause.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1239548179",
   "type": "text",
   "x": 24,
   "y": 604,
   "width": 1089.0,
