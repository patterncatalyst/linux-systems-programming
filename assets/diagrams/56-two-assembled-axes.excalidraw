   "versionNonce": 1944076407,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "P2300 senders are absent from both bands by design: __cpp_lib_senders is still undefined here, so the seventh arm links NVIDIA's reference implementation, not the standard library.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "P2300 senders are absent from both bands by design: __cpp_lib_senders is still undefined here, so the seventh arm links NVIDIA's reference implementation, not the standard library.",
   "lineHeight": 1.25,
   "baseline": 11
  }
