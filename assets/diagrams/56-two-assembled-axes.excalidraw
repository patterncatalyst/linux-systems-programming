   "roundness": null,
   "seed": 1175369593,
   "versionNonce": 1424455077,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "NEITHER band is measured in ch56. Both are assembled from earlier chapters' own measurements, carried into the table arm as named constants beside the instrument that produced them \u2014 the pattern ch54 established.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "NEITHER band is measured in ch56. Both are assembled from earlier chapters' own measurements, carried into the table arm as named constants beside the instrument that produced them \u2014 the pattern ch54 established.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t238910032",
   "type": "text",
   "x": 24,
   "y": 586,
   "width": 931.7,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#555555",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 937213153,
   "versionNonce": 1184463458,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Cost and capability move together and in opposite directions: the more a paused computation costs, the fewer restrictions there are on where it may pause.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Cost and capability move together and in opposite directions: the more a paused computation costs, the fewer restrictions there are on where it may pause.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
