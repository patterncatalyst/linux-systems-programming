  {
   "id": "t1296465552",
   "type": "text",
   "x": 24,
   "y": 568,
   "width": 1282.6000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
