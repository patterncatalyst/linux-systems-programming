  {
   "id": "t1460607114",
   "type": "text",
   "x": 40,
   "y": 550,
   "width": 901.45,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
