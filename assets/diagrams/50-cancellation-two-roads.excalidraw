   "seed": 831701458,
   "versionNonce": 1806273707,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Both rows are real runs on this host (glibc 2.43). The upper row is why pthread_cancel is powerful; the dashed box is why C++ did not standardize it.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Both rows are real runs on this host (glibc 2.43). The upper row is why pthread_cancel is powerful; the dashed box is why C++ did not standardize it.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1494993766",
   "type": "text",
   "x": 40,
   "y": 574,
   "width": 919.6,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1696487655,
   "versionNonce": 1209491852,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The trap is not that cancellation skips cleanup \u2014 it does not. The trap is that the mechanism is an exception the caller must be careful never to catch.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The trap is not that cancellation skips cleanup \u2014 it does not. The trap is that the mechanism is an exception the caller must be careful never to catch.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t747073651",
