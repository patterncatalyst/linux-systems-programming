   "roundness": null,
   "seed": 1658024898,
   "versionNonce": 1317263134,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Both cancel cases are hard-gated in verify.lua, including the abort: exit 134 with 'exception not rethrown' on stderr.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Both cancel cases are hard-gated in verify.lua, including the abort: exit 134 with 'exception not rethrown' on stderr.",
   "lineHeight": 1.25,
   "baseline": 11
  }
