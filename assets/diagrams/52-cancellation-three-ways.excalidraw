  {
   "id": "t1668068613",
   "type": "text",
   "x": 40,
   "y": 510,
   "width": 810.7,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 708199021,
   "versionNonce": 340975476,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "All three rows are real runs on this host. The ch50 abort and the ch52 survival are both hard-gated, in their own chapters' harnesses.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "All three rows are real runs on this host. The ch50 abort and the ch52 survival are both hard-gated, in their own chapters' harnesses.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1349780853",
   "type": "text",
   "x": 40,
   "y": 534,
   "width": 1010.3500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 412906267,
   "versionNonce": 1012615206,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The difference is not how careful the caller is \u2014 it is what the mechanism IS. A forced unwind must propagate; an ordinary exception need not; a flag cannot be caught.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The difference is not how careful the caller is \u2014 it is what the mechanism IS. A forced unwind must propagate; an ordinary exception need not; a flag cannot be caught.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t47099868",
   "type": "text",
   "x": 40,
   "y": 558,
   "width": 895.4000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 484616425,
   "versionNonce": 43695288,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Power runs left to right; safety runs right to left. Boost.Thread is the only one of the three that is both catchable and non-fatal when mishandled.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Power runs left to right; safety runs right to left. Boost.Thread is the only one of the three that is both catchable and non-fatal when mishandled.",
   "lineHeight": 1.25,
   "baseline": 11
  }
 ],
