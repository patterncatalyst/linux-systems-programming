  {
   "id": "t1878400557",
   "type": "text",
   "x": 40,
   "y": 556,
   "width": 1064.8000000000002,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
