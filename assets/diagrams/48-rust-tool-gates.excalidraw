   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Hard lane needs only the pinned toolchain \u2014 rustfmt and clippy ship as rust-toolchain.toml components, so all five gates run offline with no cargo install.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Hard lane needs only the pinned toolchain \u2014 rustfmt and clippy ship as rust-toolchain.toml components, so all five gates run offline with no cargo install.",
   "lineHeight": 1.25,
   "baseline": 12
  },
  {
   "id": "t1251017633",
