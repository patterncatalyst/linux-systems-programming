   "seed": 849207329,
   "versionNonce": 1115324760,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Gated lane needs `cargo install <tool>` (cargo-audit also needs the advisory-db over network) \u2014 not run on this host; watch/flamegraph/sccache are accelerators shown, not gated.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Gated lane needs `cargo install <tool>` (cargo-audit also needs the advisory-db over network) \u2014 not run on this host; watch/flamegraph/sccache are accelerators shown, not gated.",
   "lineHeight": 1.25,
   "baseline": 12
  }
