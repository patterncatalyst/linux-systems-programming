   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Cost and capability move together, and in opposite directions: the more a paused computation costs, the fewer restrictions there are on where it may pause.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Cost and capability move together, and in opposite directions: the more a paused computation costs, the fewer restrictions there are on where it may pause.",
