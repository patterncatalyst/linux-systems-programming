   "seed": 133158314,
   "versionNonce": 176508137,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Identical bytes reach the peer either way \u2014 the gate checks that too. What differs is the number of times the process crosses into the kernel.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Identical bytes reach the peer either way \u2014 the gate checks that too. What differs is the number of times the process crosses into the kernel.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t848703042",
   "type": "text",
   "x": 40,
   "y": 538,
   "width": 834.9000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
