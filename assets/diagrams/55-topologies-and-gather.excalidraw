   "versionNonce": 226669701,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Nothing binds a port: the I/O cases use an AF_UNIX socketpair via local::connect_pair, so the example stays offline and unprivileged.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Nothing binds a port: the I/O cases use an AF_UNIX socketpair via local::connect_pair, so the example stays offline and unprivileged.",
   "lineHeight": 1.25,
   "baseline": 11
  }
