   "roundness": null,
   "seed": 1451615333,
   "versionNonce": 523316946,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "This is the readv/writev machinery Part 5 covered, reached by handing Asio a buffer sequence instead of assembling an iovec array by hand.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "This is the readv/writev machinery Part 5 covered, reached by handing Asio a buffer sequence instead of assembling an iovec array by hand.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1402082365",
   "type": "text",
   "x": 40,
   "y": 562,
   "width": 744.1500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 753922924,
   "versionNonce": 1406296034,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Syscall counts are deterministic and are gated exactly; plain write(2) is excluded because it is this program's own stdout.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Syscall counts are deterministic and are gated exactly; plain write(2) is excluded because it is this program's own stdout.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t822407181",
   "type": "text",
   "x": 40,
   "y": 586,
   "width": 804.6500000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
